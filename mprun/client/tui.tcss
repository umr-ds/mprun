#content {
    height: 1fr;
}

#list-container {
    width: 30%;
}

#search-bar {
    display: none;
}

#experiment-list, #run-list {
    width: 1fr;
    border: solid $accent;
}

#detail-panel, #run-panel {
    width: 1fr;
    border: solid $accent;
    padding: 1 2;
}

#create-placeholder {
    width: 1fr;
    height: 1fr;
    border: solid $accent;
    padding: 1 2;
    content-align: center middle;
}

ConfirmDownloadDialog {
    align: center middle;
}

#confirm-dialog {
    width: 60;
    height: auto;
    border: solid $accent;
    background: $surface;
    padding: 1 2;
}
