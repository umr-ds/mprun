#content {
    height: 1fr;
}

#list-container {
    width: 30%;
}

#search-bar {
    display: none;
}

#experiment-list, #run-list, #worker-list {
    width: 1fr;
    border: solid $accent;
}

#detail-panel, #run-panel, #worker-panel {
    width: 1fr;
    border: solid $accent;
    padding: 1 2;
}

#create-placeholder {
    width: 1fr;
    height: 1fr;
    border: solid $accent;
    padding: 1 2;
    content-align: center middle;
}

#explorer {
    height: 1fr;
}

#pane-parent, #pane-current, #pane-preview {
    width: 1fr;
    border: solid $accent;
}

#pane-parent, #pane-preview {
    padding: 1 2;
}

ConfirmDeleteDialogue, ConfirmDownloadDialog {
    align: center middle;
}

#confirm-dialog {
    width: 60;
    height: auto;
    border: solid $accent;
    background: $surface;
    padding: 1 2;
}

ExperimentPreviewModal {
    align: center middle;
}

#experiment-preview {
    width: 72;
    height: auto;
    max-height: 80%;
    border: solid $accent;
    background: $surface;
    padding: 1 2;
}
